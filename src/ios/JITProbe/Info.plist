<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A REAL Info.plist, referenced by project.yml with GENERATE_INFOPLIST_FILE: NO.
	     src/ios/project.yml records, verified against a built IPA, that xcodebuild's
	     GENERATE_INFOPLIST_FILE + INFOPLIST_FILE merge silently drops
	     UIFileSharingEnabled. This app needs it: the crash journal and the saved report
	     are only reachable through Files.app, and on a device where the probe's answer
	     is fatal, that file may be the only way the answer gets out. -->

	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>JIT Probe</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<key>MinimumOSVersion</key>
	<string>15.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>

	<!-- arm64 only. NOT "metal": this app never touches the GPU, and requiring a
	     capability it does not use would exclude a device whose JIT answer is still
	     worth having. -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>

	<!-- How the report leaves the device when the screen cannot be read, which on a
	     device that kills the app is the case that matters. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- An empty dict is the documented minimum and yields a plain system-background
	     launch screen. UNVERIFIED: not yet through xcodebuild. Same caveat as
	     src/ios/Info.plist, which carries this identical key. -->
	<key>UILaunchScreen</key>
	<dict/>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
